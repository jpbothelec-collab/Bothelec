# ---------- Bothelec Aircon Solutions server settings ----------
# Copy to .env and fill in. Never commit .env — it holds passwords.

# Your domain (point its DNS A record at the VPS first). Used by Caddy for HTTPS.
DOMAIN=aircon.example.co.za
PUBLIC_URL=https://aircon.example.co.za
TZ=Africa/Johannesburg

# First admin login (only used on the very first start)
ADMIN_EMAIL=you@example.co.za
ADMIN_PASSWORD=choose-a-long-password

# true = start with the demonstration building and sample jobs; false = start empty
SEED_DEMO=true

# Bothelec service desk contact for alerts (can also be changed in Settings)
DESK_PHONE=0821234567
DESK_EMAIL=servicedesk@example.co.za

# ---------- SMS ----------
# bulksms | teltonika | gsm | log   (log = print to the server log only)
SMS_PROVIDER=bulksms
# BulkSMS: bulksms.com → Settings → API Tokens → create token
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=
# Optional registered sender ID (e.g. Bothelec) — leave empty to use BulkSMS's shared number
BULKSMS_FROM=
# Optional: STANDARD | ECONOMY | PREMIUM
BULKSMS_ROUTING=
SMS_DEFAULT_COUNTRY=27

# Alternative: send SMS through a Teltonika router's SMS gateway (Services → Mobile Utilities → SMS Gateway → Post/Get)
TELTONIKA_URL=
TELTONIKA_USER=
TELTONIKA_PASS=
# Alternative: USB GSM modem on the same machine (needs: npm install serialport, and the device passed into the container)
GSM_PORT=/dev/ttyUSB0
GSM_BAUD=115200

# ---------- Email ----------
# gmail | smtp | log
EMAIL_PROVIDER=gmail
# Gmail / Google Workspace: turn on 2-Step Verification, then create an App Password
# at https://myaccount.google.com/apppasswords (16 characters).
GMAIL_USER=alerts@example.co.za
GMAIL_APP_PASSWORD=
EMAIL_FROM=Bothelec Aircon Solutions <alerts@example.co.za>
EMAIL_REPLY_TO=servicedesk@example.co.za
# For EMAIL_PROVIDER=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------- Inbound SMS webhook (GSM alarm modems) ----------
# Long random string. Webhook URL: https://<domain>/api/hooks/sms-inbound?token=<WEBHOOK_TOKEN>
WEBHOOK_TOKEN=

# ---------- Zoho Books (invoicing) ----------
# Data centre of your Zoho account: com | eu | in | com.au | jp | ca | sa
ZOHO_DC=com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=

# ---------- MQTT (only if routers publish to the bundled broker) ----------
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=bothelec
MQTT_PASSWORD=
