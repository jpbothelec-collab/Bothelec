# Copy to .env and fill in real values. Never commit the real .env.

ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/companion_platform

# S3-compatible storage for encrypted ID documents / portfolio media.
S3_BUCKET=companion-platform-uploads
S3_REGION=af-south-1
# Leave unset for AWS S3. Set this if using Xneelo Object Storage,
# DigitalOcean Spaces, or another S3-compatible provider.
S3_ENDPOINT_URL=

# Days to retain raw ID documents after a review decision (POPIA minimization).
ID_DOCUMENT_RETENTION_DAYS=30

# Scheduled maintenance jobs (APScheduler, in-process).
# Set to false on all-but-one process when running multiple web workers, so
# the daily jobs fire once rather than once per worker.
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Africa/Johannesburg
PURGE_JOB_HOUR=2
UNPUBLISH_JOB_HOUR=3

# AWS credentials (boto3 also reads these from the environment/instance role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Paystack billing
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Pre-create this plan once in the Paystack dashboard (fixed monthly price,
# no trial) and paste its plan_code here.
PAYSTACK_CLIENT_PREMIUM_PLAN_CODE=
CLIENT_PREMIUM_MONTHLY_FEE_ZAR=149.00
BILLING_CALLBACK_URL=https://example.com/billing/callback

