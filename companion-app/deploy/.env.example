# ── Amicora deployment configuration ─────────────────────────────────────
# Copy to `.env` (never commit .env) and fill in real values.
# Generate secrets with:  openssl rand -hex 32

# --- Reverse proxy / domain ------------------------------------------------
# IP-only first launch:  ":80"
# When you add a domain:  amicora.co.za   (Caddy then auto-issues HTTPS)
# Multiple hosts allowed, space-separated: "amicora.co.za www.amicora.co.za"
SITE_ADDRESS=:80

# Images subdomain for TLS image serving (domain mode only). Leave unset in
# IP-only mode. When set, point S3_PUBLIC_ENDPOINT_URL at it over https.
#   Domain:  s3.amicora.co.za
# S3_ADDRESS=s3.amicora.co.za

# Browser origin(s) allowed to call the API. With the same-origin /api proxy
# this isn't strictly used, but set it to how users reach the site.
#   IP:      http://203.0.113.10
#   Domain:  https://amicora.co.za
CORS_ORIGINS=http://CHANGE_ME_SERVER_IP

# --- Application secret -----------------------------------------------------
# JWT signing key. MUST be long and random. `openssl rand -hex 32`
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=amicora
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=amicora

# --- Object storage (MinIO) -------------------------------------------------
MINIO_ROOT_USER=amicora-storage
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_storage_password
# Built-in KMS key so server-side encryption works (the app encrypts every
# upload). Format: "<name>:<base64 32 bytes>". Generate the key part with:
#   openssl rand -base64 32
# KEEP THIS STABLE — changing/losing it makes encrypted objects unreadable.
MINIO_KMS_SECRET_KEY=amicora-key:CHANGE_ME_base64_32_bytes
S3_BUCKET=amicora-uploads
S3_REGION=af-south-1
# Browser-facing endpoint used to sign image URLs. Must be reachable from
# users' browsers — the server's public IP (or host) on port 9000.
#   IP-only:  http://203.0.113.10:9000
#   Domain (after adding an s3 subdomain + TLS — see README): https://s3.amicora.co.za
S3_PUBLIC_ENDPOINT_URL=http://CHANGE_ME_SERVER_IP:9000

# --- Billing (Paystack) — optional; leave blank until configured -----------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CLIENT_PREMIUM_PLAN_CODE=
BILLING_CALLBACK_URL=http://CHANGE_ME_SERVER_IP/account
