# SITE_ADDRESS is ":80" for IP-only access, or your domain (e.g.
# amicora.co.za) — a bare domain triggers automatic HTTPS via Let's Encrypt.
{$SITE_ADDRESS} {
	encode gzip

	# API: strip the /api prefix and forward to the FastAPI backend, whose
	# routes live at the root (/auth, /profiles, ...). Same origin as the
	# web app, so the browser makes no cross-origin requests.
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# Everything else: the Next.js server.
	handle {
		reverse_proxy frontend:3000
	}
}

# Object storage over TLS. Set S3_ADDRESS to your images subdomain
# (e.g. s3.example.com) so browser-facing signed URLs are HTTPS and avoid
# mixed-content blocking. Defaults to a harmless local-only address when
# unset (IP-only mode, where images are served directly from MinIO :9000).
{$S3_ADDRESS} {
	reverse_proxy minio:9000
}
